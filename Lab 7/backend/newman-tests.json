				{
					"name": "Test 1.2: Get Function by ID (GET) - FunctionResponse",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"// Проверяем, что functionId установлен",
									"const functionId = pm.collectionVariables.get(\"functionId\");",
									"if (!functionId) {",
									"    console.error(\"functionId is not set. Run Test 1.1 first.\");",
									"}"
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200 OK\", function() {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Response matches FunctionResponse DTO structure\", function() {",
									"    var response = pm.response.json();",
									"    ",
									"    // Проверка структуры FunctionResponse",
									"    const functionId = pm.collectionVariables.get(\"functionId\");",
									"    const parsed = parseInt(functionId);",
									"    console.log(functionId, \" equals \", parsed)",
									"    pm.expect(response.id).to.eql(parsed);",
									"    pm.expect(response.userId).to.eql(parseInt(pm.collectionVariables.get(\"testUserId\")));",
									"    pm.expect(response.name).to.eql(\"test\");",
									"    pm.expect(response.type).to.eql(\"TABULATED_ARRAY\");",
									"    pm.expect(response.pointCount).to.eql(100);",
									"    pm.expect(response.functionClass).to.eql(\"SqrFunction\");",
									"});",
									"",
									"pm.test(\"Response schema validation\", function() {",
									"    var schema = {",
