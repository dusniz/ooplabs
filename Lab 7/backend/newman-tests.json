				{
					"name": "Test 3.1: Create User (POST) - UserRequest",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"// Добавляем заголовок авторизации для администратора",
									"const adminToken = pm.collectionVariables.get(\"adminToken\");",
									"if (adminToken) {",
									"    pm.request.headers.add({",
									"        key: \"Authorization\",",
									"        value: `Bearer ${adminToken}`",
									"    });",
									"}",
									"",
									"// Подготавливаем UserRequest",
									"pm.request.body.raw = JSON.stringify({",
									"    \"username\": \"testuser\",",
									"    \"passwordHash\": \"$2a$10$N9qo8uLOickgx2ZMRZoMye0nGxwB6JY5pY7D0BvH.5VQ5F4Y8zK\",",
									"    \"role\": \"USER\"",
									"});"
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 201 Created\", function() {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"pm.test(\"Response is valid UserResponse DTO\", function() {",
									"    var response = pm.response.json();",
									"    ",
									"    // Проверяем все поля UserResponse",
									"    pm.expect(response).to.have.property(\"id\");",
									"    pm.expect(response).to.have.property(\"username\");",
									"    pm.expect(response).to.have.property(\"role\");",
									"    ",
									"    // Проверяем значения",
									"    pm.expect(response.username).to.eql(\"testuser\");",
									"    pm.expect(response.role).to.eql(\"USER\");",
									"    ",
									"    // Сохраняем ID пользователя",
									"    pm.collectionVariables.set(\"userId\", response.id);",
									"    console.log(`✅ User created with ID: ${response.id}, username: ${response.username}`);",
									"});"
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
