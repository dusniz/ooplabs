				{
					"name": "Initialize Variables and API Base URL",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"// Установка базовых переменных",
									"pm.collectionVariables.set(\"baseUrl\", \"http://localhost:8080\");",
									"pm.collectionVariables.set(\"apiVersion\", \"v1\");",
									"",
									"// Пользовательские данные",
									"pm.collectionVariables.set(\"testUserId\", 1);",
									"pm.collectionVariables.set(\"testUsername\", \"testuser\");",
									"pm.collectionVariables.set(\"testPasswordHash\", \"$2a$10$N9qo8uLOickgx2ZMRZoMye0nGxwB6JY5pY7D0BvH.5VQ5F4Y8zK\");",
									"",
									"// ID для хранения созданных сущностей",
									"pm.collectionVariables.set(\"functionId\", \"1\");",
									"pm.collectionVariables.set(\"pointId\", \"1\");",
									"pm.collectionVariables.set(\"userId\", \"1\");",
									"",
									"// Формируем базовый URL API",
									"const baseUrl = pm.collectionVariables.get(\"baseUrl\");",
									"const apiVersion = pm.collectionVariables.get(\"apiVersion\");",
									"const apiBaseUrl = `${baseUrl}`;",
									"pm.collectionVariables.set(\"apiBaseUrl\", apiBaseUrl);",
									"",
									"console.log(`API Base URL: ${apiBaseUrl}`);",
									"console.log(`Test User ID: ${pm.collectionVariables.get('testUserId')}`);"
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Server is reachable\", function() {",
									"    pm.response.to.be.notFound;",
									"});",
									"",
									"pm.test(\"Response time is reasonable\", function() {",
									"    pm.expect(pm.response.responseTime).to.be.below(2000);",
									"});"
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
